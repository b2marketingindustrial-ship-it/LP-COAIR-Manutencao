---
// Carrossel infinito de logos — primitivo do padrão B2 (template/src/components/BrandCarousel.astro).
import { Image } from 'astro:assets'
import { brands } from '../data/brands'

/**
 * Menos de 4 logos não faz carrossel: o loop fica visível e a seção parece vazia.
 * Nesse caso o carrossel não renderiza e o cabeçalho da seção que o hospeda ocupa
 * a largura inteira.
 *
 * COAIR: cada logo aparece na largura dele, com o mesmo espaço entre todos, em vez de
 * casas de largura fixa (com casas iguais, o logo estreito ficava cercado de vazio).
 * Os arquivos vêm recortados e com a mesma área, em 2x da exibição. No mobile, 80%.
 * Três cópias da lista, para o loop não abrir buraco quando o trilho é mais largo que
 * uma cópia.
 */
const show = brands.length >= 4
const copies = [0, 1, 2]
---

{show && (
  <div class="brand-carousel relative overflow-hidden">
    <div class="brand-carousel-track flex items-center">
      {copies.map((copy) => (
        <ul
          class="flex shrink-0 items-center"
          aria-label={copy === 0 ? 'Marcas atendidas' : undefined}
          aria-hidden={copy > 0 ? 'true' : undefined}
        >
          {brands.map((brand) => {
            const width = Math.round(brand.src.width / 2)
            return (
              <li class="flex shrink-0 items-center px-4">
                <Image
                  src={brand.src}
                  alt={brand.name}
                  width={width}
                  densities={[1, 2]}
                  format="webp"
                  loading="lazy"
                  decoding="async"
                  style={`--logo-w: ${width}px`}
                  class="h-auto w-[calc(var(--logo-w)*0.8)] max-w-none lg:w-(--logo-w)"
                />
              </li>
            )
          })}
        </ul>
      ))}
    </div>
  </div>
)}

<style>
  .brand-carousel {
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0,
      black 32px,
      black calc(100% - 32px),
      transparent 100%
    );
    mask-image: linear-gradient(
      to right,
      transparent 0,
      black 32px,
      black calc(100% - 32px),
      transparent 100%
    );
  }

  .brand-carousel-track {
    width: max-content;
    animation: brand-scroll 26s linear infinite;
  }

  .brand-carousel:hover .brand-carousel-track {
    animation-play-state: paused;
  }

  /* Anda uma cópia (um terço do trilho) e recomeça, sem emenda visível */
  @keyframes brand-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-100% / 3));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .brand-carousel-track {
      animation: none;
    }
  }
</style>
