---
/**
 * Como funciona — fase "apoio" da biblioteca B2, no visual COAIR.
 *
 * Painel navy dentro de uma seção clara: é uma das duas seções que carregam bloco
 * navy (`carriesNavy`), o respiro escuro da primeira metade da página. Mesma
 * moldura do painel de identificação da LP de peças (cantos verdes, destaque verde
 * no título, CTA verde), com as etapas numeradas ligadas por uma linha.
 */
import Section from '@components/Section.astro'
import Icon from '@components/Icon.astro'
import Button from '@components/Button.astro'
import Eyebrow from '@components/Eyebrow.astro'
import type { SectionProps } from '@lib/layout'
import { cta } from '@data/content'
import { process, type ProcessStep } from '@data/sections/processo'

type Props = SectionProps

const { tone, rhythm } = Astro.props
const steps: readonly ProcessStep[] = process.steps

// Divide o H2 para pintar o trecho de destaque sem duplicar o texto nos dados
const [titleBefore, ...titleRest] = process.title.split(process.highlight)
const titleAfter = titleRest.join(process.highlight)
const hasHighlight = titleRest.length > 0
---

<Section id="processo" tone={tone} rhythm={rhythm} container={false} class="relative isolate">
  <div class="mx-auto max-w-[1212px] px-6 lg:px-10">
    <div class="process-panel navy-premium relative overflow-hidden rounded-2xl border border-white/10 p-6 shadow-[0_24px_48px_-30px_rgba(0,24,48,0.7)] sm:p-8 lg:px-10 lg:py-9">
      <span aria-hidden="true" class="blueprint-grid pointer-events-none absolute inset-0"></span>
      <span
        aria-hidden="true"
        class="pointer-events-none absolute -top-24 -right-20 size-72 rounded-full bg-brand-green/10 blur-3xl"
      ></span>

      <div class="relative">
        <div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between lg:gap-12">
          <div class="max-w-2xl">
            <Eyebrow tone="light" accent="green" shape="dash">
              {process.eyebrow}
            </Eyebrow>
            <h2 class="mt-3 font-display text-3xl leading-tight font-extrabold text-neutral-light sm:text-[34px]">
              {hasHighlight ? (
                <>
                  {titleBefore}
                  <span class="process-highlight">{process.highlight}</span>
                  {titleAfter}
                </>
              ) : (
                process.title
              )}
            </h2>
            <p class="mt-2 font-sans text-[15px] leading-relaxed text-neutral-light/80">
              {process.text}
            </p>
          </div>

          <div class="flex flex-col items-stretch gap-3 lg:shrink-0 lg:items-center">
            <Button cta="processo-cta" variant="brand-glow" class="w-full lg:w-auto">
              {cta.secondary}
            </Button>
            <span class="flex items-center justify-center gap-2 font-sans text-[13px] text-neutral-light/85">
              <Icon name="headset" class="size-[18px] shrink-0 text-neutral-light" />
              {process.microcopy}
            </span>
          </div>
        </div>

        <ol
          class="scroll-track mt-8 -mx-6 flex snap-x snap-mandatory gap-4 overflow-x-auto px-6 pb-2 sm:mx-0 sm:grid sm:grid-cols-2 sm:gap-5 sm:overflow-visible sm:px-0 sm:pb-0 lg:grid-cols-[repeat(var(--process-steps),minmax(0,1fr))]"
          style={`--process-steps: ${steps.length}`}
        >
          {steps.map((step, i) => (
            <li class="process-step relative flex w-[74%] shrink-0 snap-start flex-col gap-2.5 rounded-xl border border-[#5d85b0]/45 bg-white/[0.03] p-4 sm:w-auto">
              <div class="flex items-center gap-3">
                <span class="process-badge relative z-[2] flex size-11 shrink-0 items-center justify-center rounded-full border border-white/45 text-neutral-light">
                  <Icon name={step.icon} class="size-[18px]" />
                </span>
                <span
                  aria-hidden="true"
                  class="font-display text-[11px] font-extrabold tracking-[0.2em] text-brand-green"
                >
                  {String(i + 1).padStart(2, '0')}
                </span>
              </div>

              <h3 class="font-display text-[15px] leading-snug font-extrabold text-neutral-light">
                {step.title}
              </h3>

              <p class="font-sans text-[13px] leading-relaxed text-neutral-light/70">
                {step.description}
              </p>

              {step.when && (
                <span class="mt-auto inline-flex w-fit items-center gap-1.5 rounded-full border border-white/15 bg-white/5 px-2.5 py-1 font-sans text-[10px] font-bold tracking-[0.16em] text-neutral-light/75 uppercase">
                  <Icon name="clock" class="size-3 shrink-0 text-brand-green" />
                  {step.when}
                </span>
              )}
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>
</Section>

<style>
  /* Acentos verdes nos cantos superior esquerdo e inferior direito, seguindo a curva. */
  .process-panel::before,
  .process-panel::after {
    content: '';
    position: absolute;
    z-index: 2;
    width: 56px;
    height: 48px;
    border: 0 solid var(--color-brand-green);
    pointer-events: none;
  }

  .process-panel::before {
    top: 0;
    left: 0;
    border-top-width: 4px;
    border-left-width: 4px;
    border-top-left-radius: 15px;
    mask-image: linear-gradient(135deg, #000 45%, transparent 85%);
  }

  .process-panel::after {
    right: 0;
    bottom: 0;
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-bottom-right-radius: 15px;
    mask-image: linear-gradient(315deg, #000 45%, transparent 85%);
  }

  .process-highlight {
    background: linear-gradient(90deg, #a6f08f, var(--color-brand-green));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  /* Seta de ligação entre as etapas, no vão entre os cards (desktop). */
  @media (width >= 64rem) {
    .process-step:not(:last-child)::after {
      content: '';
      position: absolute;
      top: 38px;
      right: -1.25rem;
      z-index: 1;
      width: 1.25rem;
      height: 1px;
      background: rgb(63 220 90 / 0.6);
      pointer-events: none;
    }
  }

  .process-step {
    transition:
      background-color 260ms ease,
      border-color 260ms ease;
  }

  .process-step:hover {
    border-color: rgb(63 220 90 / 0.55);
    background-color: rgb(255 255 255 / 0.06);
  }

  .process-badge {
    transition:
      transform 260ms ease,
      border-color 260ms ease;
  }

  .process-step:hover .process-badge {
    transform: translateY(-2px);
    border-color: rgb(63 220 90 / 0.8);
  }

  @media (prefers-reduced-motion: reduce) {
    .process-step,
    .process-badge {
      transition: none;
    }

    .process-step:hover .process-badge {
      transform: none;
    }
  }
</style>
